# =============================================================================
# SideQuest backend - example environment file
# Copy this file to `.env` for local development and replace any "replace-me" secrets.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=SideQuest
APP_URL=http://localhost:3000
API_PREFIX=api
API_DEFAULT_VERSION=1

# --- Frontend / CORS ---------------------------------------------------------
# Primary frontend origin (Vite dev server by default). Switch this to the
# production frontend URL in non-dev environments - it is the source of truth
# for the React app's base URL too.
FRONTEND_URL=http://localhost:5173
#
# Optional additional CORS origins (comma-separated). Useful for preview
# deployments, native shells, or multiple local frontends. FRONTEND_URL is
# always allowed automatically; in non-production, http://localhost:5173 is
# also added as a fallback.
CORS_ORIGINS=

# --- Database (used by Prisma + Postgres container) --------------------------
POSTGRES_USER=sidequest
POSTGRES_PASSWORD=sidequest
POSTGRES_DB=sidequest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sidequest:sidequest@localhost:5432/sidequest?schema=public

# --- JWT secrets -------------------------------------------------------------
# Note: SideQuest uses a split-token architecture (short-lived access + rotating
# refresh). If you only know about a single `JWT_SECRET`, set both of these to
# different long random strings.
JWT_ACCESS_SECRET=replace-me-access-dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-refresh-dev
JWT_REFRESH_EXPIRES_IN=7d

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=debug

# --- Throttler ---------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Geolocation (centred on Prague for MVP) ---------------------------------
GEO_DEFAULT_LAT=50.0755
GEO_DEFAULT_LNG=14.4378
GEO_DEFAULT_RADIUS_METERS=5000

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# --- Future: Redis (for BullMQ + WS pub/sub) ---------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Future: Notification providers ------------------------------------------
NOTIFICATIONS_ENABLED=false
