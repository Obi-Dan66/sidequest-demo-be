# Application
NODE_ENV=development
PORT=3000
APP_NAME=SideQuest
APP_URL=http://localhost:3000
API_PREFIX=api
API_DEFAULT_VERSION=1

# Database (used by Prisma + Postgres container)
POSTGRES_USER=sidequest
POSTGRES_PASSWORD=sidequest
POSTGRES_DB=sidequest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sidequest:sidequest@localhost:5432/sidequest?schema=public

# JWT
JWT_ACCESS_SECRET=replace-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Throttler
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Geolocation (placeholders - external providers added later)
GEO_DEFAULT_LAT=50.0755
GEO_DEFAULT_LNG=14.4378
GEO_DEFAULT_RADIUS_METERS=5000

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# Future: Redis (for BullMQ + WS pub/sub)
REDIS_HOST=localhost
REDIS_PORT=6379

# Future: Notification providers
NOTIFICATIONS_ENABLED=false
