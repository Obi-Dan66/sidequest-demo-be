// SideQuest - Prisma schema
// Conventions:
//  - Primary keys are CUIDs (string) for portability and offline-friendliness.
//  - Timestamps: createdAt + updatedAt on every persisted entity.
//  - Soft-delete is intentionally avoided in MVP. Add `deletedAt` per-table only if required.
//  - Geolocation is stored as separate `latitude` / `longitude` Float columns for MVP.
//    Future: enable PostGIS and migrate to a `geography(Point, 4326)` column.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  USER
  MODERATOR
  ADMIN
  BUSINESS_OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
  EPIC
}

enum QuestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestCompletionStatus {
  STARTED
  COMPLETED
  ABANDONED
  EXPIRED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum AchievementType {
  QUEST_COUNT
  XP_THRESHOLD
  CATEGORY_EXPLORER
  LOCATION_VISITS
  SOCIAL
  STREAK
  CUSTOM
}

enum BusinessStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VisitSource {
  QUEST
  QR
  DIRECT
  REFERRAL
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ----------------------------------------------------------------------------
// Users & auth
// ----------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  bio          String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  /// Lowercase city slug for leaderboards (v1 default `prague`).
  primaryCity String @default("prague")

  // Gamification
  xp                   Int       @default(0)
  level                Int       @default(1)
  questsDone           Int       @default(0)
  /// When set (non-empty), replaces the level-derived title on `UserDto.title`.
  titleOverride        String?
  streakDays           Int       @default(0)
  longestStreakDays    Int       @default(0)
  placesVisited        Int       @default(0)
  distanceWalkedM      Int       @default(0)
  lastQuestCompletedAt DateTime?

  // Auth metadata
  lastLoginAt        DateTime?
  refreshTokenHash   String?
  emailVerifiedAt    DateTime?
  lastSeenAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  questCompletions      QuestCompletion[]
  questLocationCheckIns QuestLocationCheckIn[]
  questRatings          QuestRating[]
  achievements          UserAchievement[]
  authoredQuests     Quest[]            @relation("QuestAuthor")
  sentFriendRequests Friendship[]       @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]   @relation("FriendshipAddressee")
  businesses         Business[]         @relation("BusinessOwner")
  businessVisits     BusinessVisit[]
  invitesSent        Invite[]           @relation("InviteInviter")
  invitesReceived    Invite[]           @relation("InviteInvitee")
  notifications      Notification[]

  @@index([role])
  @@index([status])
  @@index([status, primaryCity])
  @@index([level])
}

// ----------------------------------------------------------------------------
// Quests
// ----------------------------------------------------------------------------

model QuestCategory {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  description   String?
  iconUrl       String?
  coverImageUrl String?
  colorHex      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quests Quest[]

  @@index([slug])
}

model Quest {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  summary     String?
  description String
  difficulty  QuestDifficulty @default(EASY)
  status      QuestStatus     @default(DRAFT)
  xpReward    Int             @default(50)
  estimatedDurationMin Int?
  imageUrl      String?
  coverImageUrl String?

  // Author/curator
  authorId String?
  author   User?    @relation("QuestAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  // Category
  categoryId String?
  category   QuestCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Optional business linkage (sponsorship / partnership)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  tags        String[]   @default([])
  ratingAvg   Float?
  ratingCount Int        @default(0)

  publishedAt DateTime?
  startsAt    DateTime?
  endsAt      DateTime?

  /// Set by admins/curators to pin a quest on the public landing stats.
  featuredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations           QuestLocation[]
  completions         QuestCompletion[]
  locationCheckIns    QuestLocationCheckIn[]
  ratings             QuestRating[]
  rewardAchievements  QuestRewardAchievement[]
  businessVisits      BusinessVisit[]

  @@index([status])
  @@index([status, featuredAt])
  @@index([difficulty])
  @@index([categoryId])
  @@index([businessId])
  @@index([publishedAt])
}

// A quest can have one or many locations.
// For MVP we store lat/lng directly; PostGIS migration is documented in SKILL.md.
model QuestLocation {
  id        String @id @default(cuid())
  questId   String
  quest     Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)

  name      String?
  address   String?
  latitude  Float
  longitude Float
  radiusM   Int    @default(50) // proximity radius required to "check in"
  orderIndex Int   @default(0)  // sequence within multi-stop quests

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questId])
  @@index([latitude, longitude])

  checkIns QuestLocationCheckIn[]
}

model QuestLocationCheckIn {
  id         String   @id @default(cuid())
  userId     String
  questId    String
  locationId String
  latitude   Float
  longitude  Float
  accuracyM  Int?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest    Quest         @relation(fields: [questId], references: [id], onDelete: Cascade)
  location QuestLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId, questId])
}

model QuestCompletion {
  id      String                @id @default(cuid())
  userId  String
  questId String
  status  QuestCompletionStatus @default(STARTED)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  xpAwarded   Int       @default(0)
  durationMin Int?

  // Snapshot of check-in proof - flexible JSON payload (timestamps, lat/lng pairs, photo refs)
  proof Json?

  checkedInLocationIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([status])
  @@index([status, completedAt])
  @@index([userId])
  @@index([questId])
}

model QuestRating {
  id        String   @id @default(cuid())
  userId    String
  questId   String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([questId])
}

// ----------------------------------------------------------------------------
// Achievements
// ----------------------------------------------------------------------------

model Achievement {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  iconUrl     String?
  type        AchievementType
  // Flexible criteria (e.g. { "minQuests": 10, "categorySlug": "history" }).
  // Evaluated by the gamification engine in code.
  criteria    Json
  xpBonus     Int             @default(0)
  targetValue Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unlockedBy     UserAchievement[]
  rewardedByQuests QuestRewardAchievement[]

  @@index([type])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime?
  progress      Int         @default(0)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model QuestRewardAchievement {
  questId       String
  achievementId String

  quest       Quest       @relation(fields: [questId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([questId, achievementId])
}

// ----------------------------------------------------------------------------
// Social - Friendships
// ----------------------------------------------------------------------------

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)

  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Businesses
// ----------------------------------------------------------------------------

model Business {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  websiteUrl  String?
  logoUrl     String?
  status      BusinessStatus @default(PENDING_VERIFICATION)

  // Primary location for the business (optional).
  address   String?
  latitude  Float?
  longitude Float?

  ownerId String?
  owner   User?   @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  onboardingStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quests Quest[]
  visits BusinessVisit[]

  @@index([status])
  @@index([latitude, longitude])
}

model BusinessVisit {
  id         String      @id @default(cuid())
  businessId String
  questId    String?
  userId     String?
  source     VisitSource @default(QUEST)
  createdAt  DateTime    @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quest    Quest?   @relation(fields: [questId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}

model Invite {
  id         String       @id @default(cuid())
  token      String       @unique
  inviterId  String
  email      String
  status     InviteStatus @default(PENDING)
  sentAt     DateTime     @default(now())
  acceptedAt DateTime?
  inviteeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inviter User  @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User? @relation("InviteInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  @@index([inviterId, status])
}

// ----------------------------------------------------------------------------
// Notifications (delivery-agnostic record, future BullMQ jobs hydrate transports)
// ----------------------------------------------------------------------------

model Notification {
  id      String  @id @default(cuid())
  userId  String
  type    String  // canonical: QUEST_COMPLETED, FRIEND_REQUEST_RECEIVED, … (legacy dotted strings still readable)
  title   String
  body    String?
  // Free-form payload consumed by clients to build deep-links / actions.
  data    Json?
  readAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type])
}
